{
  "arch": "aarch64",
  "linux_arch": "arm64",
  "firmware": "payload",
  "linux_defconfig": "configs/linux_defconfig",
  "dtb": {
    "mode": "static"
  },
  "linux_embed_bootargs": true,
  "payload": {
    "base": "0x40000000",
    "kernel_offset": "0x200000",
    "dtb_align": "0x200000"
  },
  "defaults": {
    "harts": 1,
    "bootargs": "console=ttyAMA0 earlycon",
    "memory_base": "0x40000000",
    "memory_size": "0x40000000",
    "qemu_binary": "/home/lurker/workspace/arm64-simpoint/arm-qemu/build/qemu-system-aarch64",
    "qemu_machine": "mini-virt",
    "qemu_cpu": "cortex-a57",
    "qemu_memory": "1024M"
  },
  "profiles": {
    "hello": {
      "workload": "hello",
      "harts": 1
    }
  }
}
