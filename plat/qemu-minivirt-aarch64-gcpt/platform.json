{
  "arch": "aarch64",
  "linux_arch": "arm64",
  "firmware": "gcpt",
  "linux_defconfig": "../qemu-minivirt-aarch64/configs/linux_defconfig",
  "dtb": {
    "mode": "static"
  },
  "linux_embed_bootargs": true,
  "resources": {
    "libcheckpoint-for-aarch64": {
      "type": "git",
      "url": "https://github.com/tastynoob/libcheckpoint-for-aarch64.git",
      "dest": "libcheckpoint-for-aarch64"
    }
  },
  "gcpt": {
    "link_address": "0x40000000",
    "payload_position": "0x40200000"
  },
  "payload": {
    "base": "0x40200000",
    "kernel_offset": "0x200000",
    "dtb_align": "0x200000"
  },
  "reserved_memories": [
    {
      "name": "gcpt",
      "start": "0x40000000",
      "size": "0x200000",
      "no_map": true
    }
  ],
  "defaults": {
    "harts": 1,
    "bootargs": "console=ttyAMA0 earlycon",
    "memory_base": "0x40000000",
    "memory_size": "0x200000000",
    "qemu_binary": "qemu-system-aarch64",
    "qemu_machine": "mini-virt",
    "qemu_cpu": "neoverse-n1",
    "qemu_memory": "8G"
  },
  "profiles": {
    "hello": {
      "workload": "hello",
      "harts": 1
    },
    "gemm": {
      "workload": "gemm",
      "harts": 1
    },
    "coremark": {
      "workload": "coremark",
      "harts": 1
    },
    "spec": {
      "workload": "spec",
      "harts": 1
    }
  }
}
